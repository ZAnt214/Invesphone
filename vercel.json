{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "redirects": [
    {
      "source": "/",
      "destination": "/base/",
      "permanent": false
    },
    {
      "source": "/invesphone",
      "destination": "/base/",
      "permanent": false
    },
    {
      "source": "/invesphone/:path*",
      "destination": "/base/",
      "permanent": false
    }
  ]
}

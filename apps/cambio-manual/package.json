    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "playwright": "^1.63.0",
    "@types/node": "^24.0.0"
  }
}
